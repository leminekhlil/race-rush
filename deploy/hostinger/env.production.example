# Race Rush API — production environment (Hostinger). Copy to racerush-app/.env and fill the values.
# NEVER commit or share the real .env file.

APP_NAME="Race Rush"
APP_ENV=production
# Generate once: `php artisan key:generate --force` (SSH, inside racerush-app/)
# or paste "base64:" followed by the output of `openssl rand -base64 32`.
APP_KEY=
APP_DEBUG=false
APP_URL=https://racerush.pro.mr
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_DAILY_DAYS=14
LOG_LEVEL=warning
LOG_DEPRECATIONS_CHANNEL=null

# hPanel → Databases → MySQL Databases (Hostinger prefixes names with your account id, e.g. u535953249_).
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=u535953249_racerush
DB_USERNAME=u535953249_racerush
DB_PASSWORD=

# The API is token based (Sanctum bearer tokens): file drivers are enough on shared hosting.
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
MAIL_MAILER=log

# Realtime server (multiplayer, server-validated rewards, voice signalling). Leave empty while no realtime
# server is deployed: solo races then run offline (no rewards). Same value as the realtime server's secret.
RACERUSH_REALTIME_SECRET=
RACERUSH_TICKET_TTL=900
