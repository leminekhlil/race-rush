# Race Rush realtime server — environment (VPS). Copy to .env next to server.mjs; never commit the real file.
PORT=8090
HOST=127.0.0.1
# Laravel API base URL (rewards are settled through signed internal calls).
API_URL=https://racerush.pro.mr
# Shared secret: SAME value as RACERUSH_REALTIME_SECRET in racerush-app/.env. Generate: openssl rand -hex 32
RACERUSH_REALTIME_SECRET=
# true = allows ticket-less guests (no rewards). Keep false in production.
ALLOW_ANONYMOUS=false
# Voice chat (WebRTC). STUN is public. TURN is optional: coturn with `use-auth-secret`; credentials are minted per
# player by this server and expire after VOICE_TURN_TTL seconds — the secret never reaches the browser.
VOICE_ENABLED=true
VOICE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302
VOICE_TURN_URLS=
VOICE_TURN_SECRET=
VOICE_TURN_TTL=3600
